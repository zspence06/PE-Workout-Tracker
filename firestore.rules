rules_version = '2';

// Memorial PE Workout Tracker -- Firestore security rules
//
// Model: a student record's DOCUMENT ID is the secret.
//   id = PBKDF2(pin, salt = normalized name, 100k iterations, SHA-256)
// No PIN -- and no hash of a PIN -- is stored in any document. Reaching a record
// requires already knowing both the student's name and their PIN.

service cloud.firestore {
  match /databases/{database}/documents {

    // Shape of a student record. Note the absence of any credential field.
    // Workout history is no longer stored here -- it lives in the history
    // subcollection below, so a roster can be listed without downloading it.
    function isStudentShape(d) {
      return d.keys().hasAll(['name', 'routines'])
             && d.name is string
             && d.name.size() > 0
             && d.name.size() < 120
             && d.routines is list;
    }

    match /students/{studentId} {
      allow get:    if true;                     // safe: the address is unguessable
      allow list:   if request.auth != null;     // only the teacher may enumerate
      allow create: if request.auth != null
                    || isStudentShape(request.resource.data);
      // A student may write their own record (they proved knowledge of the PIN by
      // reaching this address at all) but may never rename it onto someone else.
      allow update: if request.auth != null
                    || (isStudentShape(request.resource.data)
                        && request.resource.data.name == resource.data.name);
      allow delete: if request.auth != null;     // a PIN reset relocates a record
    }

    // "Is this name already claimed?" Keyed by sha256("name:" + name), so the
    // roster cannot be listed out -- only checked for a name already known.
    // Holds no PIN information whatsoever. This is what stops a mistyped PIN
    // from silently creating a second, empty account for an existing student.
    match /names/{nameKey} {
      allow get:    if true;
      allow list:   if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 120;
      allow update, delete: if request.auth != null;
    }

    // The daily learning target. One document, read by every student on load,
    // written only by the teacher. Text is teacher-authored, so no shape check
    // beyond keeping it a string of sane length.
    match /settings/{key} {
      allow get:    if true;
      allow list:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() < 500;
    }

    // A student's workout log rows, one document each. Reachable only through
    // the parent student document id, which is the PBKDF2 address -- the same
    // secret that protects the student record itself. Listing these requires
    // already knowing that address, so it is protected identically.
    match /students/{studentId}/history/{logId} {
      allow read, write: if true;
    }

    // Class periods. Students have to read the list to pick their class, so it
    // is world-readable -- a class name is not a secret, and joining one grants
    // nothing but a label the teacher can override. Only the teacher writes.
    // There is no delete: classes are frozen, never removed.
    match /classes/{classId} {
      allow get, list: if true;
      allow create, update: if request.auth != null
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() < 100;
      allow delete: if false;
    }

    // Firestore already denies anything unmatched; stated here for clarity.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
